# Verum — Environment Variables
# Copy to .env.local for local dev; set the same vars in the Vercel dashboard.

# === Supabase (server) ===
# Project URL and keys from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://mvedaurabbwemlqdzwml.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SECRET — service role key. Bypasses RLS. Server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Auth ===
# Shared access token gating the app. Use a long random value, e.g.:
#   openssl rand -base64 32
JOURNAL_ACCESS_TOKEN=your-secret-token-here

# SECRET — signs the session cookie issued at login. Rotate it to invalidate
# every outstanding session ("log out everywhere"). Falls back to
# JOURNAL_ACCESS_TOKEN when unset.
SESSION_SECRET=

# Allow unauthenticated GET requests (default: false).
# Scope: journal reads, quotes, streak, life markers. The full export
# (/api/entries/export) and notification settings always require a session.
JOURNAL_PUBLIC_READ=false

# === Day semantics (optional) ===
# IANA timezone the server uses for "today" (daily quote pick, streak,
# anniversaries, entry-day fallback). Matches the notification scheduling
# default. The browser client always uses the device's local date.
APP_TIMEZONE=Europe/London

# === Quotes config (optional) ===
# Score at/above which a quote is "core" (default: 3)
QUOTES_CORE_THRESHOLD=3
# Days to avoid re-showing a recently picked quote (default: 14)
QUOTES_AVOID_DAYS=14

# === Life calendar (optional, public/client) ===
# Date of birth and life expectancy in years for the calendar grid.
NEXT_PUBLIC_DOB=1993-12-19
NEXT_PUBLIC_LIFE_YEARS=108

# === Web Push (notifications) ===
# Generate a keypair with: npx web-push generate-vapid-keys
# Public key is exposed to the browser; private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:you@example.com

# === Cron ===
# Shared secret protecting /api/cron/notifications. Set the same value in Vercel
# so its scheduler sends `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
